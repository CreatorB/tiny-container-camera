{
  "manifest_version": 3,
  "name": "Tiny Container Camera",
  "version": "0.1.3",
  "description": "Use your Android camera as a webcam on any website (Teams, Meet, Zoom...) in Firefox inside Tiny Computer / proot Linux, over ADB or an MJPEG app.",
  "homepage_url": "https://github.com/CreatorB/tiny-container-camera",
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tiny-container-camera@creatorb",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*"
  ],
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html"
  },
  "action": {
    "default_title": "Tiny Container Camera",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "isolated.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
